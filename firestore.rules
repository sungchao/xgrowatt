rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read for status/tesla_live so Wear OS and mobile apps can receive live telemetry
    match /status/tesla_live {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Restrict all other documents to authenticated users
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
